# Secrets file for docker-compose templates
# Copy this file to .secrets.yml and fill in your actual values
# The .secrets.yml file should be added to .gitignore

# Watchtower (automatic container updates)
WATCHTOWER_NOTIFICATION_URL: discord://webhook_id/token@channel_id
WATCHTOWER_HTTP_API_TOKEN: your-api-token-here

# Radarr (movie collection manager)
RADARR_API_KEY: your-radarr-api-key

# Sonarr (TV show collection manager)
SONARR_API_KEY: your-sonarr-api-key

# Uptime Kuma (monitoring)
UPTIME_KUMA_NOTIFICATION_URL: your-discord-webhook

# ClouDNS (DNS provider)
CLOUDNS_AUTH_PASSWORD: your-cloudns-password
CLOUDNS_AUTH_USER: your-clounds-sub-auth-id

# OAuth2 Proxy
OAUTH2_CLIENT_SECRET: your-oauth2-client-secret
OAUTH2_COOKIE_SECRET: your-oauth2-cookie-secret

# Autobrr (torrent announcement handling)
AUTOBRR_API_KEY: your-autobrr-api-key

# Speedtest Tracker
SPEEDTEST_APP_KEY: base64:your-laravel-app-key
SPEEDTEST_API_KEY: your-speedtest-tracker-api-key

# Beszel (monitoring agent)
BESZEL_AGENT_TOKEN: your-beszel-agent-token

# Plex
PLEX_API_KEY: your-plex-api-key

# Tautulli (Plex monitoring)
TAUTULLI_API_KEY: your-tautulli-api-key

# Prowlarr (indexer management)
PROWLARR_API_KEY: your-prowlarr-api-key

# Bazarr (subtitle management)
BAZARR_API_KEY: your-bazarr-api-key

# Overseerr (media request platform)
OVERSEERR_API_KEY: your-overseerr-api-key
